@page "/rsadecryptpage/"
@using CryptDemo.Components
@using CryptDemo.Model

<PageTitle>RSA（復号化） | CryptDemo</PageTitle>

<HeaderComponent />

<main class="main">
    <div class="card">
        <h1>RSA（復号化）</h1>
        <p>
            暗号文と秘密鍵を指定してください。
            暗号文は Base64 で文字列化されたものを指定し、秘密鍵は暗号化時に利用した公開鍵とペアのものを設定する必要があります。
        </p>
    </div>

    <RsaComponent Mode="@Mode.DecryptOnly" />
</main>

<Hamburger ShouldDisplayInline="false" />


