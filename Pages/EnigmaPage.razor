@page "/enigmapage/"
@using CryptDemo.Components
@using CryptDemo.Model

<HeaderComponent />

<main class="main">
    <div class="card">
        <h1>エニグマ</h1>
        <p>
            エニグマは、第二次世界大戦中にドイツ軍が使用した暗号化装置で、回転ローターを使用してメッセージを暗号化します。
            ヴィジュネル暗号の原理を複数回適用することで、複雑な暗号化を実現しています。
        </p>
        <p>
            ロータは全部で 5 つあり、この中から 3 つを選んでセットします。
            またロータを指定する際には、初期位置も指定する必要があります。
        </p>
        <div class="table-container">
            <table class="vigenere-square">
                <tr>
                    <th>ロータ</th>
                    @for (int i = 0; i < Alphabet.AlphabetUpperString.Length; i++)
                    {
                        <th>@Alphabet.AlphabetUpperString[i]</th>
                    }
                    <th>導入年</th>
                </tr>
                @{
                    // ロータ番号
                    string[] rotorNumbers = new string[]
                    {
                        "I", "II", "III", "IV", "V",
                    };
                    // 導入年たち
                    string[] years = new string[]
                    {
                        "1930", "1930", "1930", "1938", "1938",
                    };
                }
                @for (int i = 0; i < this.rotors.Length; i++)
                {
                    <tr>
                        <td class="key">@rotorNumbers[i]</td>
                        @for (int j = 0; j < this.rotors[i].Length; j++)
                        {
                            <td>@this.rotors[i][j]</td>
                        }
                        <td>@years[i]</td>
                    </tr>
                }
            </table>
        </div><!-- .table-container -->
        <p>
            重要なのはリフレクタです。
            リフレクタは相互マッピングします。
            例えば、「A」に対して「E」が対応する場合、「E」に対しては「A」が対応します。
            このリフレクタの性質により、入力された文字は必ず異なる文字となって出力されます。
            リフレクタは 3 つあり、この中から 1 つを選んでセットする必要があります。
        </p>
        <div class="table-container">
            <table class="vigenere-square">
                <tr>
                    <th>リフレクタ</th>
                    @for (int i = 0; i < Alphabet.AlphabetUpperString.Length; i++)
                    {
                        <th>@Alphabet.AlphabetUpperString[i]</th>
                    }
                </tr>
                @{
                    string reflectorSigns = "ABC";
                }
                @for (int i = 0; i < reflectorSigns.Length; i++)
                {
                    <tr>
                        <td class="key">@reflectorSigns[i]</td>
                        @for (int j = 0; j < this.reflectors[i].Length; j++)
                        {
                            <td>
                                @this.reflectors[i][j]
                            </td>
                        }
                    </tr>
                }
            </table>
        </div><!-- .table-container -->
        <p>
            プラグボードの設定は任意です。
            エニグマの前面に任意の文字とそれとは異なる文字をペアで配線します。
            ドイツ軍は 10 組のプラグを使用していたようです。
        </p>
        <p>
            平文に、連続する同じ文字をひたすら入力してみてください。
            頻度分析結果に、その文字の文字数が 0 になることが確認できるはずです。
        </p>
    </div>

    <EnigmaComponent OnEncrypted="@this.OnEncrypted" />
    @if (this.cipher != null)
    {
        <DecryptorComponent Cipher="@this.cipher" CryptedMessage="@this.encryptedMessage" />
    }
    <FrequencyAnalyserComponent Message="@this.encryptedMessage" />
</main>

<Hamburger ShouldDisplayInline="false" />


@code {
    private string encryptedMessage = "";
    private IDecryptable cipher;
    private string[] rotors;
    private string[] reflectors;

    /// <summary>
    /// 初期化
    /// </summary>
    protected override void OnInitialized()
    {
        Enigma enigma = new Enigma();
        this.rotors = enigma.Rotors;
        this.reflectors = enigma.Reflectors;
    }

    /// <summary>
    /// 暗号化時に頻度分析器に渡す
    /// </summary>
    /// <param name="message"></param>
    private void OnEncrypted(DecryptEventArgs decryptEventArgs)
    {
        this.encryptedMessage = decryptEventArgs.EncryptedMessage;
        this.cipher = decryptEventArgs.Cipher;
    }
}
