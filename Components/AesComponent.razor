@using System.Security.Cryptography;
@using System.Text;
@using CryptDemo.Model;
@implements IAsyncDisposable;
@inject HttpClient Http;
@inject IJSRuntime JS;

<section class="card">
    @if (this.Mode == Mode.Encrypt)
    {
        <h2>暗号化</h2>
    }
    else
    {
        <h2>復号化</h2>
    }

    @if (this.Mode == Mode.Encrypt)
    {
        <p>文字列を入力してください。</p>
        <p><button @onclick="@this.ReadSampleData">サンプルデータ読込</button></p>
        <p>
            <textarea placeholder="ここに平文を入力してください" @bind="@this.message"></textarea>
        </p>
    }
    else
    {
        <p>暗号文を入力してください。暗号文は Base64 文字でなければなりません。</p>
        <p>
            <textarea placeholder="ここに暗号文を入力してください" value="@this.encryptedMessage" @oninput="this.OnInputEncryptedMessage"></textarea>
        </p>
    }

    <p>
        <label for="key">キー : </label>
        <input type="text" id="key" maxlength="25" value="@this.key" @oninput="this.OnInputKeyphrase" />
    </p>
    @if (this.Mode == Mode.Encrypt)
    {
        <p>
            <button @onclick="this.Encrypt">暗号化する</button>
        </p>
        <p>
            <textarea readonly="readonly" @bind="@this.encryptedMessage"></textarea>
        </p>
    }
    else
    {
        <p>
            <button @onclick="this.Decrypt">復号化する</button>
        </p>
        <p class="warning">@this.warning</p>
        <p>
            <textarea readonly="readonly" @bind="@this.message"></textarea>
        </p>
    }
</section>

@code {
    private IJSObjectReference? jsModule;
    private string message;
    private string encryptedMessage;
    private string key;
    private string warning;

    /// <summary>
    /// 親コンポーネントに暗号化済メッセージを渡すコールバック
    /// </summary>
    [Parameter]
    public EventCallback<DecryptEventArgs> OnEncrypted
    {
        set; private get;
    }

    [Parameter]
    public Mode Mode
    {
        set; private get;
    }

    /// <summary>
    /// JS モジュール読込初期化
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        this.jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/aesCrypto.js");
    }

    /// <summary>
    /// サンプルデータをフェッチで読み込む
    /// </summary>
    /// <returns>サニタイズ済サンプルデータ</returns>
    private async Task ReadSampleData()
    {
        string text = await Http.GetStringAsync("ref/alices-adventures.txt");
        this.message = text;
    }

    /// <summary>
    /// 暗号化する
    /// </summary>
    /// <returns></returns>
    private async Task Encrypt()
    {
        this.encryptedMessage = "";
        if (!string.IsNullOrEmpty(this.message) &&
            !string.IsNullOrEmpty(this.key) && this.jsModule is not null)
        {
            AesCipher aesCipher = new AesCipher(this.jsModule, this.key);
            this.encryptedMessage = await aesCipher.EncryptAsync(this.message);
            // 親コンポーネント経由で頻度分析器に渡す
            DecryptEventArgs decryptEventArgs = new DecryptEventArgs(this.encryptedMessage, aesCipher);
            await this.OnEncrypted.InvokeAsync(decryptEventArgs);
        }
    }

    /// <summary>
    /// 復号化する
    /// </summary>
    private async Task Decrypt()
    {
        this.message = "";
        this.warning = "";
        if (!this.IsValidBase64(this.encryptedMessage)) {
            this.warning = "暗号文のフォーマットが不適切です。";
        }
        else if (!string.IsNullOrEmpty(this.encryptedMessage) &&
            !string.IsNullOrEmpty(this.key) &&
            this.jsModule is not null)
        {
            try
            {
                AesCipher aesCipher = new AesCipher(this.jsModule, this.key);
                this.message = await aesCipher.DecryptAsync(this.encryptedMessage);
            }
            catch (Exception ex)
            {
                this.warning = "復号に失敗しました。暗号文または鍵を確認してください。";
            }
        }
    }

    /// <summary>
    /// Base64 形式かどうかをチェックする
    /// </summary>
    /// <param name="text"></param>
    /// <returns></returns>
    private bool IsValidBase64(string text)
    {
        // 十分な大きさを確保
        Span<byte> buffer = new byte[(text.Length * 3) / 4];
        return Convert.TryFromBase64Chars(text, buffer, out _);
    }

    /// <summary>
    /// 暗号文入力時のチェック
    /// </summary>
    /// <param name="e"></param>
    private void OnInputEncryptedMessage(ChangeEventArgs e)
    {
        string value = e.Value?.ToString() ?? "";
        this.encryptedMessage = this.Sanitize(value);
    }

    /// <summary>
    /// キーフレーズ入力時のチェック
    /// </summary>
    /// <param name="e"></param>
    private void OnInputKeyphrase(ChangeEventArgs e)
    {
        string value = e.Value?.ToString() ?? "";
        this.key = this.Sanitize(value);
    }

    /// <summary>
    /// 余計な文字たちを除去する
    /// </summary>
    /// <param name="text">汚い文字列</param>
    /// <returns>綺麗になった文字列</returns>
    private string Sanitize(string text)
    {
        return new string(
            text.Where(ch =>
            {
                return ('A' <= ch && ch <= 'Z') || ('a' <= ch && ch <= 'z') ||
                ('0' <= ch && ch <= '9') || ch == '+' || ch == '/' || ch == '=';
            }).ToArray()
        );
    }

    /// <summary>
    /// JS モジュール廃棄処理
    /// </summary>
    /// <returns></returns>
    public async ValueTask DisposeAsync()
    {
        if (this.jsModule is not null)
        {
            await this.jsModule.DisposeAsync();
            this.jsModule = null;
        }
    }
}
