@code {
    private string message;
    private Dictionary<char, int> frequencies;

    /// <summary>
    /// 頻度分析する文字列
    /// </summary>
    [Parameter]
    public string Message
    {
        set
        {
            this.message = value;
        }
    }

    /// <summary>
    /// パラメータ変更時に処理する
    /// </summary>
    protected override void OnParametersSet()
    {
        this.frequencies = FrequencyAnalyser.Analyse(this.message);
    }
}
