@using CryptDemo.Model;
@inject HttpClient Http;

<section class="card">
    @if (this.Mode == Mode.Encrypt)
    {
        <h2>暗号化</h2>
    }
    else
    {
        <h2>復号化</h2>
    }

    <p>アルファベットを入力してください。アルファベット以外入力できません。</p>
    @if (this.Mode == Mode.Encrypt)
    {
        <p><button @onclick="@this.ReadSampleData">サンプルデータ読込</button></p>
        <p>
            <textarea placeholder="ここに平文を入力してください" value="@this.message" @oninput="this.OnInputMessage"></textarea>
        </p>
    }
    else
    {
        <p>
            <textarea placeholder="ここに暗号文を入力してください" value="@this.encryptedMessage" @oninput="this.OnInputEncryptedMessage"></textarea>
        </p>
    }
    <p>
        <label for="shift">シフト : </label>
        <input type="number" id="shift" min="0" max="25" @bind="@this.shift" />
    </p>
    <p>
        <label for="keyphrase">キーフレーズ : </label>
        <input type="text" id="keyphrase" maxlength="25" value="@this.keyphrase" @oninput="this.OnInputKeyphrase" />
    </p>
    @if (this.Mode == Mode.Encrypt)
    {
        <p>
            <button @onclick="this.Encrypt">暗号化する</button>
        </p>
        <p>
            <textarea readonly="readonly" @bind="@this.encryptedMessage"></textarea>
        </p>
    }
    else
    {
        <p>
            <button @onclick="this.Decrypt">復号化する</button>
        </p>
        <p>
            <textarea readonly="readonly" @bind="@this.message"></textarea>
        </p>
    }
</section>

@code {
    private string message;
    private string encryptedMessage;
    private int shift = 0;
    private string keyphrase;

    /// <summary>
    /// 親コンポーネントに暗号化済メッセージを渡すコールバック
    /// </summary>
    [Parameter]
    public EventCallback<DecryptEventArgs> OnEncrypted
    {
        set; private get;
    }

    /// <summary>
    /// 暗号化・復号化モード
    /// </summary>
    [Parameter]
    public Mode Mode
    {
        set; private get;
    } = Mode.Encrypt;

    /// <summary>
    /// サンプルデータをフェッチで読み込む
    /// </summary>
    /// <returns>サニタイズ済サンプルデータ</returns>
    private async Task ReadSampleData()
    {
        string text = await Http.GetStringAsync("ref/alices-adventures.txt");
        this.message = this.Sanitize(text);
    }

    /// <summary>
    /// 暗号化する
    /// </summary>
    /// <returns></returns>
    private async Task Encrypt()
    {
        if (!string.IsNullOrEmpty(this.message))
        {
            this.shift = Math.Abs(this.shift) % 26;
            CaesarCipher caesarCipher;
            this.keyphrase = string.IsNullOrEmpty(this.keyphrase) ? "" : this.keyphrase;
            caesarCipher = new CaesarCipher(this.shift, this.keyphrase);
            this.encryptedMessage = caesarCipher.Encrypt(this.message);
            // 親コンポーネント経由で頻度分析器に渡す
            DecryptEventArgs decryptEventArgs = new DecryptEventArgs(this.encryptedMessage, caesarCipher);
            await this.OnEncrypted.InvokeAsync(decryptEventArgs);
        }
    }

    /// <summary>
    /// 復号化する
    /// </summary>
    private async void Decrypt()
    {
        if (!string.IsNullOrEmpty(this.encryptedMessage))
        {
            this.shift = Math.Abs(this.shift) % 26;
            CaesarCipher caesarCipher;
            this.keyphrase = string.IsNullOrEmpty(this.keyphrase) ? "" : this.keyphrase;
            caesarCipher = new CaesarCipher(this.shift, this.keyphrase);
            this.message = await caesarCipher.DecryptAsync(this.encryptedMessage);
        }
    }

    /// <summary>
    /// 平文入力時のチェック
    /// </summary>
    /// <param name="e"></param>
    private void OnInputMessage(ChangeEventArgs e)
    {
        string value = e.Value?.ToString() ?? "";
        this.message = this.Sanitize(value);
    }

    /// <summary>
    /// 平文入力時のチェック
    /// </summary>
    /// <param name="e"></param>
    private void OnInputEncryptedMessage(ChangeEventArgs e)
    {
        string value = e.Value?.ToString() ?? "";
        this.encryptedMessage = this.Sanitize(value);
    }

    /// <summary>
    /// キーフレーズ入力時のチェック
    /// </summary>
    /// <param name="e"></param>
    private void OnInputKeyphrase(ChangeEventArgs e)
    {
        string value = e.Value?.ToString() ?? "";
        this.keyphrase = this.Sanitize(value);
    }

    /// <summary>
    /// 余計な文字たちを除去する
    /// </summary>
    /// <param name="text">汚い文字列</param>
    /// <returns>綺麗になった文字列</returns>
    private string Sanitize(string text)
    {
        return new string(
            text.Where(ch =>
            {
                return ('A' <= ch && ch <= 'Z') || ('a' <= ch && ch <= 'z');
            }).ToArray()
        );
    }
}
